# Copy to .env.local and fill. NEVER commit real secrets (.gitignore covers .env*).

# Database — PostgreSQL connection string
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Auth (Better Auth) — generate a strong secret, min 32 chars
# e.g. run: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=

# Local file storage directory (default ./storage). Files are gitignored.
STORAGE_DIR=./storage
